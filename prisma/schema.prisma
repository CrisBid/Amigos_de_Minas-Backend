// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  SPONSOR
}

enum SponsorshipStatus {
  PENDING
  IN_PROGRESS
  IN_PURCHASE       // (antes "EM_COMPRA")
  PACKED            // (antes "EMBALADO")
  BOXED             // (antes "ENCAIXOTADO")
  AWAITING_DELIVERY // (antes "AGUARDO_ENTREGA")
  COMPLETED
  ENDED
  CANCELLED
}

enum SponsorshipMethod {
  GIFT
  PIX
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  FINISHED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  roles        Role[]   @default([SPONSOR])
  refreshHash  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sponsorships Sponsorship[]
  profile      Profile?

  CollectionPoint CollectionPoint[]
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  phone         String?
  cep           String?
  address       String?
  city          String?
  profession    String?
  incomeRange   String?
  maritalStatus String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id             String          @id @default(cuid())
  publicId    Int?           @unique // <— opcional: ID inteiro da campanha (para pasta)
  name           String
  slug           String          @unique
  year           Int?
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  status      CampaignStatus @default(DRAFT)

  // retrocompat (se já existe)
  frameKey       String?
  frameUrl       String?
  frameConfig    Json?

  // novo: atalho para o layout ativo
  activeFrameId  String?
  activeFrame    CampaignFrame?  @relation("CampaignActiveFrame", fields: [activeFrameId], references: [id])

  frames         CampaignFrame[] // lista de layouts

  sponsorships Sponsorship[]
  images ChildImage[]

  // crianças migradas individualmente de outra campanha (seleção manual no painel)
  includedChildren CampaignChildInclude[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

/**
 * Migração seletiva de crianças entre campanhas: cada linha diz "a criança X
 * também aparece na campanha Y", escolhida manualmente (por cidade, comunidade
 * ou individualmente) na tela de migração do painel admin — sem duplicar dados.
 */
model CampaignChildInclude {
  id               String   @id @default(cuid())

  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  childId          String
  child            Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  // de qual campanha essa criança foi migrada (apenas rastreabilidade/exibição)
  sourceCampaignId String?

  createdAt        DateTime @default(now())

  @@unique([campaignId, childId])
  @@index([childId])
}

model CampaignFrame {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id])

  // metadados do arquivo do layout
  key         String
  url         String
  mime        String
  width       Int?
  height      Int?

  // nome amigável para escolher no site
  name        String?   // ex.: "Capa padrão", "Versão natal 2"

  // configurações de composição (overlay) para este layout
  config      Json?     // ex.: { width:1080, height:1350, fit:'cover', gravity:'center', cornerRadius:0 }

  // status/ordenação
  active      Boolean   @default(false)
  sort        Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([campaignId, active])
  Campaign Campaign[] @relation("CampaignActiveFrame")
}


model City {
  id        String   @id @default(cuid())
  publicId  Int      @unique
  name      String
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children     Child[]
  communities  Community[]
  schools      School[]

  @@index([name, state])
}

model Community {
  id          String   @id @default(cuid())
  publicId    Int?     @unique
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  name        String
  slug        String?
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  schools     School[]
  children    Child[]

  @@unique([cityId, name])         // Evita comunidades duplicadas na mesma cidade
  @@index([cityId, name])
}

model School {
  id          String   @id @default(cuid())
  publicId    Int?     @unique
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  name        String
  slug        String?
  address     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  children    Child[]

  @@unique([cityId, name])         // Nome de escola único por cidade
  @@index([cityId, communityId, name])
}

model CollectionPoint {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?

  // Localização 100% desnormalizada (texto livre)
  address     String?
  district    String?
  cityName    String?
  state       String?
  zipCode     String?

  // Geo (opcional; salve como texto/decimal simples)
  lat         Decimal? @db.Decimal(9,6)
  lng         Decimal? @db.Decimal(9,6)

  // Responsável opcional (usuário)
  responsibleUserId String?
  responsibleUser   User?     @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)

  phone       String?
  openingJson Json?
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Inverso
  sponsorships Sponsorship[]

  @@index([active])
  @@index([cityName, state])
  @@index([responsibleUserId])
  @@unique([name, cityName, state]) // evita duplicados no mesmo município/UF
}

model Child {
  id          String    @id @default(cuid())
  publicId    Int       @unique
  name        String
  birthDate   DateTime?
  age         Int?
  motherName  String?

  // Cidade (como já tinha)
  cityId      String?
  city        City?     @relation(fields: [cityId], references: [id])
  cityName    String

  // NOVO: relacionamentos normalizados (retrocompat abaixo)
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id])

  schoolId    String?
  school      School?    @relation(fields: [schoolId], references: [id])

  // LEGADO: mantém o texto antigo para busca/compatibilidade
  schoolLegacy String?    // <- renomeie de 'school' para 'schoolLegacy' na migração

  category    String?
  wantedGift  String?
  photoUrl    String?
  photoKey    String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  sponsorships Sponsorship[]
  images       ChildImage[]
  campaignIncludes CampaignChildInclude[]

  @@index([cityId, communityId, schoolId])
}

model Sponsorship {
  id         String             @id @default(cuid())
  childId    String
  sponsorId  String
  campaignId String
  status     SponsorshipStatus  @default(PENDING)
  method     SponsorshipMethod  @default(GIFT)

  donationAmount Decimal?       @db.Decimal(10,2)
  pixTxid        String?
  pixPaidAt      DateTime?

  // Ponto de coleta escolhido (opcional)
  collectionPointId String?
  collectionPoint   CollectionPoint? @relation(fields: [collectionPointId], references: [id], onDelete: SetNull)

  startDate  DateTime?
  endDate    DateTime?
  note       String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  child    Child    @relation(fields: [childId], references: [id])
  sponsor  User     @relation(fields: [sponsorId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([childId, campaignId])
  @@index([childId])
  @@index([sponsorId])
  @@index([campaignId])
  @@index([status])
  @@index([method])
  @@index([collectionPointId])
}

enum ChildImageStatus {
  ORIGINAL_UPLOADED // original recebido e salvo
  PROCESSED // gerou .webp (sem layout)
  COMPOSED // gerou com layout (framed)
  ERROR // falha em algum passo
}

model ChildImage {
  id      String @id @default(cuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  // Opcional: amarração à campanha (p/ layout/coleções)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  // Arquivo original recebido (obrigatório)
  originalKey String
  originalUrl String

  // Arquivo processado em .webp (sem layout)
  processedKey String?
  processedUrl String?

  // Arquivo final com layout (overlay)
  framedKey String?
  framedUrl String?

  // Qual layout foi usado (snapshot para rastreabilidade)
  layoutKey String?
  layoutUrl String?

  // Configuração usada para compor (crop/enquadramento etc.)
  // Ex.: { width:1080, height:1350, fit:"cover", gravity:"center", cornerRadius:0 }
  Config Json?

  // Metadados úteis
  width  Int?
  height Int?
  status ChildImageStatus @default(ORIGINAL_UPLOADED)
  notes  String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([childId, campaignId])
}
